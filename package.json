{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --import dotenv/config node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --import dotenv/config node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --import dotenv/config dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "build:docker": "docker compose build backend",
    "start:dev:docker": "docker compose up backend",
    "stop:dev:docker": "docker compose down",
    "logs:docker": "docker compose logs -f backend",
    "db:start:docker": "docker compose up -d --wait postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:docker": "docker compose exec -T backend pnpm db:migrate",
    "db:migrate:create": "drizzle-kit generate --custom",
    "db:seed": "tsx --import dotenv/config scripts/seed.ts",
    "db:seed:docker": "docker compose exec -T backend pnpm db:seed",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "api:export": "pnpm build && node scripts/export-openapi.mjs",
    "api:check": "pnpm build && node scripts/export-openapi.mjs --check",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "node scripts/generate-api-types.mjs --check",
    "test:auth:integration": "pnpm build && node scripts/test-auth-integration.mjs",
    "test:topics:integration": "pnpm build && node scripts/test-topics-integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "argon2": "0.45.2",
    "cookie": "2.0.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.3.0",
    "jose": "6.2.16",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.37.0",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
