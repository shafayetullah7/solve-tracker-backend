{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --import dotenv/config node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node --import dotenv/config node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --import dotenv/config dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "docker:dev:build": "docker compose build backend",
    "docker:dev": "docker compose up backend",
    "docker:down": "docker compose down",
    "logs:docker": "docker compose logs -f backend",
    "db:start:docker": "docker compose up -d --wait postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:docker": "docker compose exec -T backend pnpm db:migrate",
    "db:migrate:create": "drizzle-kit generate --custom",
    "db:seed": "tsx --import dotenv/config scripts/seed.ts",
    "db:seed:discover-demo": "tsx --import dotenv/config scripts/seed-discover-demo.ts",
    "db:seed:docker": "docker compose exec -T backend pnpm db:seed",
    "db:backfill:platform-slugs": "tsx --import dotenv/config scripts/backfill-problem-platform-slugs.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "api:export": "pnpm build && node scripts/export-openapi.mjs",
    "api:check": "pnpm build && node scripts/export-openapi.mjs --check",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "node scripts/generate-api-types.mjs --check",
    "test:auth:integration": "pnpm build && node scripts/test-auth-integration.mjs",
    "test:auth-identities:integration": "pnpm build && node scripts/test-auth-provider-identities.mjs",
    "test:risc-receipts:integration": "pnpm build && node scripts/test-risc-receipts.mjs",
    "test:google-risc-handle:integration": "pnpm build && node scripts/test-google-risc-handle.mjs",
    "test:google-risc-http:integration": "pnpm build && node scripts/test-google-risc-http.mjs",
    "test:user-handle:integration": "node scripts/test-user-handle-schema.mjs",
    "preflight:google-risc": "node scripts/preflight-google-risc-endpoint.mjs",
    "sign:test-risc-set": "node scripts/sign-test-risc-set.mjs",
    "test:google-oauth:auth": "pnpm build && node scripts/test-google-oauth-auth.mjs",
    "test:google-oauth:integration": "pnpm build && node scripts/test-google-oauth-integration.mjs",
    "verify:google-oauth": "pnpm build && node scripts/verify-google-oauth.mjs",
    "verify:google-oauth:exit": "node scripts/verify-google-oauth-exit.mjs",
    "verify:google-risc": "pnpm build && node scripts/verify-google-risc.mjs",
    "verify:google-risc-exit": "node scripts/verify-google-risc-exit.mjs",
    "verify:user-handle": "pnpm build && node scripts/verify-user-handle.mjs",
    "verify:user-handle:exit": "node scripts/verify-user-handle-exit.mjs",
    "test:topics:integration": "pnpm build && node scripts/test-topics-integration.mjs",
    "test:profile:integration": "pnpm build && node scripts/test-profile-integration.mjs",
    "test:problems:integration": "pnpm build && node scripts/test-problems-integration.mjs",
    "verify:phase-5": "node scripts/verify-phase-5-exit.mjs",
    "verify:phase-6": "node scripts/verify-phase-6-exit.mjs",
    "verify:phase-7": "node scripts/verify-phase-7-exit.mjs",
    "verify:phase-8": "node scripts/verify-phase-8-exit.mjs",
    "verify:phase-9": "node scripts/verify-phase-9-exit.mjs",
    "verify:platform-p1": "node scripts/verify-platform-p1.mjs",
    "verify:platform-p2": "node scripts/verify-platform-p2.mjs",
    "verify:platform-p3": "node scripts/verify-platform-p3.mjs",
    "verify:platform-p4": "node scripts/verify-platform-p4.mjs",
    "verify:platform-cls": "node scripts/verify-platform-cls.mjs",
    "verify:discover-e1": "node scripts/verify-discover-e1.mjs",
    "test:discover-people:integration": "pnpm build && node scripts/test-discover-people-integration.mjs",
    "verify:discover-e2": "node scripts/verify-discover-e2.mjs",
    "verify:discover-e3": "node scripts/verify-discover-e3.mjs",
    "test:discover:integration": "pnpm build && node scripts/test-discover-integration.mjs",
    "verify:discover-e4": "node scripts/verify-discover-e4.mjs",
    "verify:discover-e5": "node scripts/verify-discover-e5.mjs",
    "verify:discover-e6": "node scripts/verify-discover-e6.mjs",
    "verify:discover-e8": "node scripts/verify-discover-e8.mjs",
    "verify:discover-e9": "node scripts/verify-discover-e9.mjs",
    "verify:discover": "node scripts/verify-discover.mjs",
    "test:discover-compare:integration": "pnpm build && node scripts/test-discover-compare-integration.mjs",
    "test:discover-events:integration": "pnpm build && node scripts/test-discover-events-integration.mjs",
    "test:persistence:integration": "pnpm build && node scripts/test-backend-restart-persistence.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.1",
    "argon2": "0.45.2",
    "cloudinary": "2.5.1",
    "cookie": "2.0.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "express": "^5.3.0",
    "jose": "6.2.16",
    "multer": "2.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.37.0",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
