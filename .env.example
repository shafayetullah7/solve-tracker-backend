# Copy to .env before starting. These credentials are for local development.
PORT=3000
POSTGRES_USER=practice
POSTGRES_PASSWORD=practice_dev
POSTGRES_DB=practice_tracker
POSTGRES_PORT=5432

# Used by the backend, migrations, and seeds when running on the host.
# For an external database, replace this URL (including TLS options if needed).
DATABASE_URL=postgresql://practice:practice_dev@localhost:5432/practice_tracker

# Compose overrides DATABASE_URL inside the backend with this internal URL.
# Keep these credentials in sync with POSTGRES_*; encode URL special characters.
DOCKER_DATABASE_URL=postgresql://practice:practice_dev@postgres:5432/practice_tracker

NODE_ENV=development

HOST=0.0.0.0

SWAGGER_ENABLED=true

DOCKER_BIND_ADDRESS=127.0.0.1

# Authentication (development policy). Generate two independent random secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=practice-backend
JWT_AUDIENCE=practice-api
JWT_ACCESS_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_COOKIE_NAME=practice_access
AUTH_REFRESH_COOKIE_NAME=practice_refresh
FRONTEND_ORIGIN=http://localhost:3001
EMAIL_DELIVERY_MODE=mock

# Required only in EMAIL_DELIVERY_MODE=resend; never use real values in tests.
# RESEND_API_KEY=
# RESEND_FROM=Practice <noreply@your-verified-domain>

# Media uploads (Cloudinary). Placeholders until credentials are provisioned.
# See MEDIA_CONVENTIONS.md.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Production (NODE_ENV=production) — enforced by src/config/environment.ts ---
# NODE_ENV=production
# SWAGGER_ENABLED=false
# AUTH_COOKIE_SECURE=true
# AUTH_ACCESS_COOKIE_NAME=__Host-access
# AUTH_REFRESH_COOKIE_NAME=__Host-refresh
# FRONTEND_ORIGIN=https://your-public-app-origin.example
# EMAIL_DELIVERY_MODE=resend
# RESEND_API_KEY=<from secret store>
# RESEND_FROM=Practice <noreply@your-verified-domain>
# DATABASE_URL=postgresql://...?sslmode=require
# Probes: GET /health (liveness), GET /health/ready (database readiness)

# Google OAuth (optional). Ops: docs/GOOGLE_OAUTH_RESULTS.md, PRODUCTION.md § Google OAuth.
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=placeholder.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=placeholder_replace_in_secret_store
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# GOOGLE_OAUTH_SCOPES=openid email profile
# GOOGLE_OAUTH_PROMPT=select_account
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Google Cross-Account Protection / RISC (optional). docs/GOOGLE_RISC_RESULTS.md, docs/GOOGLE_RISC_STREAM_SETUP.md
GOOGLE_RISC_ENABLED=false
# GOOGLE_RISC_AUDIENCE=
# GOOGLE_RISC_JWKS_URL=
# GOOGLE_RISC_EVENT_TTL_SECONDS=2592000
